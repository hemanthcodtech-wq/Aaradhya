# ===================================================
# AARADHYA BACKEND ENVIRONMENT CONFIGURATION (RENDER)
# ===================================================

# Port: Render injects PORT automatically (defaults to 10000 or dynamic)
PORT=5000

# Environment mode
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aaradhya_fashion?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secure_jwt_secret_key_2026
JWT_EXPIRE=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Shipping Logistics (Shiprocket)
SHIPROCKET_EMAIL=your_shiprocket_email@aaradhya.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# Allowed Frontend URL (Vercel deployment URL)
CLIENT_URL=https://your-aaradhya-frontend.vercel.app
